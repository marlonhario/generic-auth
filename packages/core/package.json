{
  "name": "@marlonoirah/auth-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript contracts, validation schemas, and error codes for the auth library",
  "keywords": ["auth", "authentication", "authorization", "rbac", "better-auth", "typescript"],
  "license": "MIT",
  "author": {
    "name": "Marlon Hario"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlonhario/generic-auth.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/marlonhario/generic-auth#readme",
  "bugs": {
    "url": "https://github.com/marlonhario/generic-auth/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

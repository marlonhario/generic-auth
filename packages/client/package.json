{
  "name": "@marlonoirah/auth-client",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent authentication client wrapping Better Auth client",
  "keywords": ["auth", "client", "authentication", "better-auth"],
  "license": "MIT",
  "author": {
    "name": "Marlon Hario"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlonhario/generic-auth.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/marlonhario/generic-auth#readme",
  "bugs": {
    "url": "https://github.com/marlonhario/generic-auth/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marlonoirah/auth-core": "workspace:*",
    "better-auth": "1.7.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

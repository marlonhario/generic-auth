{
  "name": "@marlonoirah/auth-react",
  "version": "0.0.0",
  "private": true,
  "description": "Headless, theme-independent React authentication components and hooks",
  "keywords": ["react", "auth", "authentication", "rbac", "hooks", "components", "better-auth"],
  "license": "MIT",
  "author": {
    "name": "Marlon Hario"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlonhario/generic-auth.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/marlonhario/generic-auth#readme",
  "bugs": {
    "url": "https://github.com/marlonhario/generic-auth/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marlonoirah/auth-client": "workspace:*",
    "@marlonoirah/auth-core": "workspace:*",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.7",
    "jsdom": "^27.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
